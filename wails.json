{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "ez-utils",
  "outputfilename": "ez-utils",
  "frontend:dir": "./gui/frontend",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "knejadshamsi",
    "email": "k.nejadshamsi@gmail.com"
  },
  "build": {
    "tags": "wails,production,webkit2_42",
    "devtags": "wails,!production,webkit2_42",
    "debounce": 100,
    "windows": {
      "nsis": {
        "oneclick": true,
        "language": "1033"
      }
    },
    "darwin": {
      "applicationShouldTerminateAfterLastWindowClosed": true
    }
  }
}
